{
  "name": "cake-genius-1.3",
  "projectPath": "C:/Users/Zulik/cake-genius",
  "vcsPath": "C:/Users/Zulik/cake-genius",
  "scope": {
    "deployment": "none",
    "ci": false
  },
  "local": {
    "port": 8792,
    "start": [
      "server.js"
    ],
    "env": {
      "ADMIN_PASSWORD": "gate-pass",
      "PUBLIC_URL": "http://127.0.0.1:8792"
    }
  },
  "stages": {
    "syntax": [
      "node --check server.js",
      "node --check public/slots-picker.js",
      "node --check scripts/demo-check.mjs"
    ],
    "tests": [
      "node tests/cart-math.test.mjs",
      "node tests/capacity.test.mjs",
      "node tests/storage.test.mjs",
      "node tests/migration.test.mjs",
      "node tests/api-1.2.test.mjs",
      "node tests/ai-guard.test.mjs",
      "node tests/client-ip.test.mjs",
      "node tests/availability.test.mjs",
      "node tests/slots-picker.test.mjs"
    ]
  },
  "security": {
    "session": {
      "path": "/api/admin/login",
      "body": {
        "username": "admin",
        "password": "gate-pass"
      }
    },
    "authz": [
      {
        "path": "/api/admin/orders",
        "expect": 401,
        "severity": "critical"
      },
      {
        "path": "/api/admin/orders.csv",
        "expect": 401,
        "severity": "critical"
      },
      {
        "path": "/api/admin/settings",
        "expect": 401,
        "severity": "critical"
      },
      {
        "path": "/api/admin/day",
        "expect": 401,
        "severity": "critical"
      },
      {
        "path": "/api/admin/products",
        "expect": 401,
        "severity": "critical"
      }
    ]
  },
  "persistenceProbe": {
    "create": {
      "path": "/api/orders",
      "method": "POST",
      "body": {
        "customer": { "name": "عميل البقاء", "phone": "0555000111" },
        "items": [
          {
            "productId": "p-lotus",
            "config": { "size": "s6", "flavor": "vanilla", "filling": "cream", "design": "classic", "deliveryMethod": "pickup" },
            "quantity": 1
          }
        ]
      }
    },
    "idField": "order.code",
    "read": {
      "method": "POST",
      "path": "/api/orders/lookup",
      "body": { "code": "{{id}}", "phone": "0555000111" }
    },
    "verify": { "path": "order.code", "equals": "{{id}}" }
  },
  "github": null,
  "live": null
}
